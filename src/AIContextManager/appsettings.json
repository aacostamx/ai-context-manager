{
  "ContextManager": {
    "SourcePath": "C:\\Users\\O7U\\source",
    "ExcludedFolders": [ "Repos" ],
    "OutputPath": "C:\\Users\\O7U\\AI-Context",
    "Environments": [
      { "Name": "DEV", "Branch": "develop" },
      { "Name": "QA", "Branch": "release" },
      { "Name": "PROD", "Branch": "main" }
    ],
    "FetchFromGitHub": true,
    "AutoDiscover": true,
    "WatchChanges": true,
    "GitCheckMinutes": 15,
    "DebounceSeconds": 10,
    "RepomixCommand": "repomix",
    "AllowCloudPublish": false,
    "BlockOnSecrets": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  }
}
